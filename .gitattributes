# Text normalisation only. The previous round routed *.faiss / *.pkl / *.png
# through Git LFS; this submission commits no large binaries (the FAISS index and
# graph artefacts are regenerated by the ingest scripts), so LFS is not required
# and its filters are removed rather than left to fail on a machine without it.
* text=auto eol=lf
*.png binary
*.jpg binary
