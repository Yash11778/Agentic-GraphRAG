# ── Gemini (required — Pipelines 1/2/3 answer generation, dataset token count,
# QA-pair generation) ─────────────────────────────────────────────────────────
# Start with a FREE-TIER key for setup/pilot (Phases 0-3). Swap in the paid
# $50-credit key only for full-scale ingestion + full eval (Phases 4-5), which
# is where most spend happens — see project notes.
GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash          # default (current stable); override if needed
# GEMINI_INPUT_PRICE=0.15                # $/1M input tokens
# GEMINI_OUTPUT_PRICE=0.60               # $/1M output tokens

# ── TigerGraph Savanna (required for Pipeline 3 / GraphRAG) ──────────────────
# Get these from tgcloud.io → your instance → Connection Details
TG_HOST=https://<your-instance-id>.tg-<region>.i.tgcloud.io
TG_PASSWORD=<your-tg-secret>        # the Secret shown in Savanna, NOT your login password
TG_GRAPH=MyDatabase                 # graph name you created in Savanna

# ── CourtListener (optional) ──────────────────────────────────────────────
# NOT needed for scripts/download_dataset.py or download_citations.py — those
# use CourtListener's public bulk-data CSV dumps (no auth, no rate limit).
# Only needed if you use the REST API directly (free tier throttled to 5 req/min).
# COURTLISTENER_API_TOKEN=...

# ── Hugging Face (required — LLM-as-a-Judge, per hackathon spec) ─────────────
# Free HF account token: https://huggingface.co/settings/tokens
HF_TOKEN=hf_...
# HF_JUDGE_MODEL=meta-llama/Llama-3.1-8B-Instruct   # default judge model

# ── Eval / pipeline behavior toggles ──────────────────────────────────────────
# DISABLE_BERTSCORE=1        # set to skip live BERTScore (memory-constrained hosts only)
# BASIC_RAG_FULL=1           # use full FAISS index instead of the small demo index
