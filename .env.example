# ── Groq (required — answer generation for all three pipelines) ──────────────
# Key: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Optional comma-separated fallbacks, used when the primary key runs out of daily
# quota. Groq's daily token limit is per ORGANISATION, so extra keys from the same
# account share one pool; only keys from separate accounts add quota.
# GROQ_API_KEYS=gsk_second,gsk_third
# One model, one temperature, one output cap for ALL three pipelines
# (docs/ARCHITECTURE.md LOCKED-7). Token deltas must come from retrieval,
# not from one pipeline being allowed to say less.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0
GROQ_MAX_OUTPUT_TOKENS=1024
GROQ_REASONING_EFFORT=low

# ── TigerGraph Savanna (graph + vector storage) ─────────────────────────────
# tgcloud.io → workspace → Connection Details; TG_PASSWORD is a Database Secret,
# not your login password.
TG_HOST=https://tg-<id>.tg-<n>.i.tgcloud.io
TG_PASSWORD=<database secret from Savanna>
TG_GRAPH=<database name>

# ── Backend selection ───────────────────────────────────────────────────────
# local      = data/graph/*.jsonl, no network, used while developing
# tigergraph = the scored path
GRAPH_BACKEND=local
