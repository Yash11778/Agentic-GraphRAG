# ── secrets ───────────────────────────────────────────────────────────────────
.env
.env.*
*.env
!.env.example

# ── python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.venv/
venv/
.pytest_cache/

# ── node ──────────────────────────────────────────────────────────────────────
node_modules/
frontend/dist/

# ── generated artefacts (regenerate, don't commit) ────────────────────────────
# data/graph is rebuilt in seconds by agentic/ingest/build_graph.py, and the
# vector index by agentic/ingest/build_vectors.py. Committing them would put
# derived data under review instead of the code that derives it.
data/graph/
data/vectors/
data/cache/

# ── run logs (the result rows themselves are committed; see data/results) ─────
data/results/*.log
data/results/*.tmp

# ── submission material kept out of the public repo ─────────────────────────
# The architecture diagram is a required Round 1 deliverable, so docs/diagrams/
# is tracked. The demo script is the shooting notes for the video, not the
# video, and nothing outside this repo refers to it.
docs/DEMO_SCRIPT.md

# ── misc ──────────────────────────────────────────────────────────────────────
.ruff_cache/
*.bin
*_screenshot.png
.DS_Store
